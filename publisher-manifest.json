r: #FFF;font-size: 12px;font-weight: 700;padding: 2px 8px;margin-left: 10px;vertical-align: middle}\n.plan-name {font-size: 22px;font-weight: 800;color: #2B211E}\n.plan-pricing {text-align: right}\n.price-monthly {font-size: 24px;font-weight: 900;color: #B83A24}\n.price-annual {font-size: 13px;color: #6C5B55;margin-left: 8px}\n.plan-details {display: flex;justify-content: space-between;flex-wrap: wrap;gap: 20px;align-items: center}\n.feature-checklist {list-style: none;display: flex;flex-wrap: wrap;gap: 12px 24px}\n.feature-checklist li {font-size: 14px;color: #3C312E;position: relative;padding-left: 18px}\n.feature-checklist li::before {content: \"■\";color: #B83A24;position: absolute;left: 0;font-size: 11px;top: 1px}\n.plan-action a {display: inline-block;padding: 10px 22px;font-size: 14px;font-weight: 700;border: 2px solid #2B211E;background-color: #2B211E;color: #FFF9F5}\n.plan-row-item.highlight .plan-action a {background-color: #B83A24;border-color: #B83A24}\n.plan-action a:hover {text-decoration: none;opacity: 0.9}\n\n/* 使用引导 */\n.guide-flow {display: grid;grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));gap: 16px}\n.flow-step {background-color: #FFFDF9;border: 3px solid #2B211E;padding: 20px}\n.flow-num {font-size: 20px;font-weight: 900;color: #B83A24;margin-bottom: 8px}\n.flow-title {font-size: 16px;font-weight: 700;margin-bottom: 8px;color: #2B211E}\n.flow-desc {font-size: 13px;color: #554743}\n\n/* 客户端指南 */\n.clients-block {background-color: #ECE5DC;border: 3px solid #2B211E;padding: 28px}\n.clients-block h3 {font-size: 18px;font-weight: 800;margin-bottom: 12px}\n.clients-block p {font-size: 14px;color: #4A3C38;margin-bottom: 16px}\n.client-items {display: flex;gap: 12px;flex-wrap: wrap}\n.client-badge {background-color: #FFFDF9;border: 2px solid #2B211E;padding: 8px 16px;font-weight: 700;font-size: 14px}\n\n/* FAQ: 编号列表 */\n.faq-numbered-list {list-style: none;counter-reset: faq-counter;display: flex;flex-direction: column;gap: 18px}\n.faq-item {counter-increment: faq-counter;background-color: #FFFDF9;border: 3px solid #2B211E;padding: 20px 24px 20px 72px;position: relative}\n.faq-item::before {content: counter(faq-counter, decimal-leading-zero);position: absolute;left: 20px;top: 18px;font-size: 24px;font-weight: 900;color: #B83A24;line-height: 1}\n.faq-question {font-size: 16px;font-weight: 800;color: #2B211E;margin-bottom: 8px}\n.faq-answer {font-size: 14px;color: #4A3C38;line-height: 1.6}\n\n/* 页面末端 */\n.friendly-outro {background-color: #2B211E;color: #FFF9F5;padding: 40px 48px;margin-top: 40px}\n.friendly-outro h3 {font-size: 20px;font-weight: 800;margin-bottom: 8px}\n.friendly-outro p {font-size: 14px;color: #D6CBC1}\n\n/* 响应式调整 */\n@media (max-width: 860px) {.app-container {\n    flex-direction: column;}\n  .sidebar-nav {\n    width: 100%;height: auto;position: relative;border-right: none;border-bottom: 3px solid #2B211E;padding: 20px;}\n  .sidebar-menu {\n    display: flex;flex-wrap: wrap;gap: 8px;margin-top: 16px;}\n  .sidebar-menu li {\n    margin-bottom: 0;}\n  .sidebar-menu a {\n    padding: 6px 10px;font-size: 13px;}\n  .sidebar-footer {\n    display: none;}\n  .hero-band-top,\n  .hero-band-mid,\n  .hero-band-low,\n  .content-section,\n  .friendly-outro {\n    padding-left: 24px;padding-right: 24px;}\n  .hero-band-top h1 {\n    font-size: 28px;}}\n</style><div class=\"app-container\">\n  \n  <aside class=\"sidebar-nav\">\n    <div>\n      <div class=\"sidebar-brand\">国际云 DIRECT</div>\n      <ul class=\"sidebar-menu\">\n        <li><a href=\"#welcome\">开篇聊聊</a></li>\n        <li><a href=\"#services\">为什么选我们</a></li>\n        <li><a href=\"#plans\">订阅方案挑选</a></li>\n        <li><a href=\"#guide\">新手三步指引</a></li>\n        <li><a href=\"#clients\">软件与平台支持</a></li>\n        <li><a href=\"#faq\">常见疑惑解答</a></li>\n      </ul>\n    </div>\n    <div class=\"sidebar-footer\">\n      <p>给日常网络多一点踏实。<br>国际云随时为你守候。</p>\n    </div>\n  </aside>\n\n  \n  <main>\n    \n    <header id=\"welcome\">\n      <div class=\"hero-band-top\">\n        <span class=\"badge\">网络随心 · 沟通无阻</span>\n        <h1>把跨境网络交给我们，国际云帮你省下时间专心做事</h1>\n        <p>嗨，朋友！不管你是为了查阅海外学术论文、跨国协调远程项目，还是想在休息时顺畅刷刷喜爱的视频，国际云都想做你身边那个安静好用的网络助手。</p>\n      </div>\n      <div class=\"hero-band-mid\">\n        <span class=\"prompt\">我们的底色：</span>\n        <div class=\"tags-row\">\n          <span class=\"band-tag\">无套路明白消费</span>\n          <span class=\"band-tag\">多设备同时在线</span>\n          <span class=\"band-tag\">清晰配置流程</span>\n          <span class=\"band-tag\">真实工单支持</span>\n        </div>\n      </div>\n      <div class=\"hero-band-low\">\n        <span>初次接触？不用担心设置繁琐，选个适合自己的月度或年度计划就能轻松起步。</span>\n        <a href=\"#plans\" class=\"btn-cta\">立即看看套餐方案</a>\n      </div>\n    </header>\n\n    \n    <section id=\"services\" class=\"content-section\">\n      <div class=\"section-title-wrap\">\n        <h2>就像身边懂技术的朋友</h2>\n        <p>我们不讲天花乱坠的玄乎词，只把每一步的服务细节打磨实在。</p>\n      </div>\n\n      <div class=\"about-grid\">\n        <article class=\"thick-card\">\n          <h3>多端设备互不干扰</h3>\n          <p>从手边的手机、平板到办公桌上的主力笔记本，你可以把手头的常用设备都加进来，出差或者在家换着设备用，不必反复踢下线。</p>\n        </article>\n        <article class=\"thick-card\">\n          <h3>均衡合理的流量规划</h3>\n          <p>无论你是轻度的网页查阅者，还是重度依赖在线音视频、代码构建的专业开发者，流量额度清晰透明，绝不玩文字游戏。</p>\n        </article>\n        <article class=\"thick-card\">\n          <h3>耐心可靠的疑问响应</h3>\n          <p>配置遇阻或者连不上时别烦躁，后台提交工单，技术小伙伴会用通俗的语言帮你排查网络瓶颈，不甩技术黑话。</p>\n        </article>\n      </div>\n    </section>\n\n    \n    <section id=\"plans\" class=\"content-section\">\n      <div class=\"section-title-wrap\">\n        <h2>选个合适你节奏的方案</h2>\n        <p>丰俭由人，按月试用随时可调，按年订阅更省心。你可以根据手头设备量和流量需求做决定：</p>\n      </div>\n\n      <div class=\"plan-rows\">\n        \n        <article class=\"plan-row-item\">\n          <div class=\"plan-header-line\">\n            <div>\n              <span class=\"plan-name\">基础版</span>\n            </div>\n            <div class=\"plan-pricing\">\n              <span class=\"price-monthly\">¥15/月</span>\n              <span class=\"price-annual\">按年付仅需 ¥150/年</span>\n            </div>\n          </div>\n          <div class=\"plan-details\">\n            <ul class=\"feature-checklist\">\n              <li>每月 100GB 极速流量</li>\n              <li>支持 3 台设备同时在线</li>\n              <li>解锁基础流媒体</li>\n              <li>普通线路节点池</li>\n            </ul>\n            <div class=\"plan-action\">\n              <a href=\"#\">选择基础版</a>\n            </div>\n          </div>\n        </article>\n\n        \n        <article class=\"plan-row-item highlight\">\n          <div class=\"plan-header-line\">\n            <div>\n              <span class=\"plan-name\">旗舰版</span>\n              <span class=\"plan-tag-rec\">大多数朋友的省心之选</span>\n            </div>\n            <div class=\"plan-pricing\">\n              <span class=\"price-monthly\">¥35/月</span>\n              <span class=\"price-annual\">按年付仅需 ¥350/年</span>\n            </div>\n          </div>\n          <div class=\"plan-details\">\n            <ul class=\"feature-checklist\">\n              <li>每月 300GB 极速流量</li>\n              <li>支持 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7x24 优先工单支持</li>\n            </ul>\n            <div class=\"plan-action\">\n              <a href=\"#\">立即加入旗舰版</a>\n            </div>\n          </div>\n        </article>\n\n        \n        <article class=\"plan-row-item\">\n          <div class=\"plan-header-line\">\n            <div>\n              <span class=\"plan-name\">团队版</span>\n            </div>\n            <div class=\"plan-pricing\">\n              <span class=\"price-monthly\">¥85/月</span>\n              <span class=\"price-annual\">按年付仅需 ¥850/年</span>\n            </div>\n          </div>\n          <div class=\"plan-details\">\n            <ul class=\"feature-checklist\">\n              <li>每月 1000GB 极速流量</li>\n              <li>支持 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n            <div class=\"plan-action\">\n              <a href=\"#\">为团队开通</a>\n            </div>\n          </div>\n        </article>\n      </div>\n    </section>\n\n    \n    <section id=\"guide\" class=\"content-section\">\n      <div class=\"section-title-wrap\">\n        <h2>三步完成配置，不用抓头发</h2>\n        <p>不用担心看不懂参数，跟着这三步来，几分钟就能妥当上网：</p>\n      </div>\n\n      <div class=\"guide-flow\">\n        <div class=\"flow-step\">\n          <div class=\"flow-num\">01</div>\n          <div class=\"flow-title\">挑选并激活方案</div>\n          <div class=\"flow-desc\">选好符合你当月预算与流量的规格，生成属于你自己的专属连接订阅凭证。</div>\n        </div>\n        <div class=\"flow-step\">\n          <div class=\"flow-num\">02</div>\n          <div class=\"flow-title\">导入订阅配置文件</div>\n          <div class=\"flow-desc\">在你习惯的设备上打开对应客户端，将国际云用户中心里的订阅链接一键导入。</div>\n        </div>\n        <div class=\"flow-step\">\n          <div class=\"flow-num\">03</div>\n          <div class=\"flow-title\">点击开关开始体验</div>\n          <div class=\"flow-desc\">选一个离你距离较近或者符合业务需要的接入点，轻轻一拨即可恢复平稳通信。</div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"clients\" class=\"content-section\">\n      <div class=\"section-title-wrap\">\n        <h2>跨平台客户端指南</h2>\n        <p>国际云基于通用规范协议构建，你可以继续使用你在各大平台已经顺手的主流工具。</p>\n      </div>\n\n      <div class=\"clients-block\">\n        <h3>多生态兼容，随时切换</h3>\n        <p>无论你的工作环境是 Windows 桌面、macOS 工作站、Linux 生产机，还是随身的 iOS 与 Android 手机，只要导入后台提供的统一配置源，都可以即刻生效。各操作系统的具体软件配置图文教程已在用户控制面板准备齐全。</p>\n        <div class=\"client-items\">\n          <span class=\"client-badge\">Windows 10 / 11</span>\n          <span class=\"client-badge\">macOS 架构</span>\n          <span class=\"client-badge\">iOS &amp; iPadOS</span>\n          <span class=\"client-badge\">Android 各大厂商系统</span>\n          <span class=\"client-badge\">Linux 服务器环境</span>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"faq\" class=\"content-section\">\n      <div class=\"section-title-wrap\">\n        <h2>大家常常会问的几个问题</h2>\n        <p>坦诚沟通是最好的相处方式，这里是我们平时被问到最多的细节：</p>\n      </div>\n\n      <ol class=\"faq-numbered-list\">\n        <li class=\"faq-item\">\n          <div class=\"faq-question\">如果月中流量不够用了，我可以中途升级套餐吗？</div>\n          <div class=\"faq-answer\">完全可以的。进入后台控制台选择升配，系统会自动计算剩余周期的折算差价，补齐差额后即刻扩充流量额度，不需要等到下个月再变动。</div>\n        </li>\n        <li class=\"faq-item\">\n          <div class=\"faq-question\">“支持 X 台设备同时在线”具体是怎么计算的？</div>\n          <div class=\"faq-answer\">这个限制指的是在同一个时间段内，正在进行网络数据交互的活跃设备连接数。如果你家里有电脑、平板和手机，正常切换或者同时工作，只要并发数不超过方案额度就不会有任何影响。</div>\n        </li>\n        <li class=\"faq-item\">\n          <div class=\"faq-question\">我平时还要联机打游戏，旗舰版的 IPLC 节点有帮助吗？</div>\n          <div class=\"faq-answer\">帮助很明显。专线网络规避了公共公网链路容易出现的波动与抖动，在游戏跨区对战时能带来更平稳的延迟表现，减少丢包和跳跃情况。</div>\n        </li>\n        <li class=\"faq-item\">\n          <div class=\"faq-question\">完全没有配置过这类工具的新人，能搞定吗？</div>\n          <div class=\"faq-answer\">完全不用怵。我们在后台写了一份很平实的图文向导，按照截图一步一步点击就行。如果真卡在某一步，直接在工单发个截图，我们会像朋友一样帮你排查。</div>\n        </li>\n      </ol>\n    </section>\n\n    \n    <footer class=\"friendly-outro\">\n      <h3>国际云，愿做你长久可信赖的连接桥梁</h3>\n      <p>网络世界很大，希望我们能陪你走得稳当、看得顺畅。如果在使用中有任何改进建议，欢迎随时留言告诉我们。</p>\n    </footer>\n  </main>\n</div>",
